    {
      "name": "Invoices",
      "item": [
        {
          "name": "Create Invoice (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body._id) pm.environment.set('invoiceId', body._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"date\": \"2026-08-11T00:00:00.000Z\",\n  \"items\": [\n    {\n      \"costId\": \"{{costId}}\",\n      \"quantity\": 2,\n      \"unitPrice\": 50\n    },\n    {\n      \"name\": \"Manual item\",\n      \"quantity\": 1,\n      \"unitPrice\": 25\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"]
            },
            "description": "Admin only. For cost-linked items, name is resolved server-side from costId."
          }
        },
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "customerId", "value": "{{customerId}}", "disabled": true },
                { "key": "settlementId", "value": "{{settlementId}}", "disabled": true },
                { "key": "status", "value": "unpaid", "disabled": true },
                { "key": "fromDate", "value": "2026-01-01T00:00:00.000Z", "disabled": true },
                { "key": "toDate", "value": "2026-12-31T23:59:59.999Z", "disabled": true }
              ]
            },
            "description": "Admin: all invoices. Customer: own invoices only (JWT)."
          }
        },
        {
          "name": "Get Invoice by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", "{{invoiceId}}"]
            }
