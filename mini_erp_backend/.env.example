NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/mini_erp?replicaSet=rs0

JWT_ACCESS_SECRET=change_this_access_secret_to_at_least_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_to_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
# Paste the full private_key from Firebase service account JSON on one line, with \n for line breaks:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: seed first admin when none exists (both required to activate)
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
